{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "server.js:280-349",
    "server.js:510-568"
  ],
  "tempDirName": "stryker-tmp",
  "concurrency": 1,
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/cart-orders/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/cart-orders/mutation.json"
  },
  "jest": {
    "configFile": "jest.cart-orders.config.cjs"
  }
}

+
+async function createCoupon(app, admin, overrides) {
+  const input = { ...h.validAdminCoupon(), ...overrides };
+  const response = await h.request(app).post('/api/admin/coupons')
+    .set(h.bearer(admin)).send(input);
+  expect(response.status).toBe(200);
+  expect(response.body.id).toEqual(expect.any(Number));
+  return { ...input, id: response.body.id };
+}
+
+async function listCoupons(app, admin) {
+  const response = await h.request(app).get('/api/coupons').set(h.bearer(admin));
+  expect(response.status).toBe(200);
+  expect(Array.isArray(response.body)).toBe(true);
+  return response.body;
+}
+
+function quote(app, token, code, total, userId = 2) {
+  return h.request(app).post('/api/apply-coupon').set(h.bearer(token))
+    .send({ code, total_amount: total, user_id: userId });
+}
+
+function expectDiscount(response, couponId, discount, final) {
+  expect(response.status).toBe(200);
+  expect(response.body).toMatchObject({
+    success: true, coupon_id: couponId, discount_amount: discount, final_amount: final,
+  });
+}
+
+function expectRefusedQuote(response) {
+  // The SRS requires refusal; exact HTTP error codes are API conventions.
+  expect(response.status).toBeGreaterThanOrEqual(400);
+  expect(response.status).toBeLessThan(500);
+  expect(response.body).not.toHaveProperty('discount_amount');
+  expect(response.body.success).not.toBe(true);
+}
+
+async function selectCorrectCoupon(app, admin, token) {
+  await createCoupon(app, admin, { code: 'CHOICE_A', discount_value: 10000 });
+  const chosen = await createCoupon(app, admin, { code: 'CHOICE_B', discount_value: 27000 });
+  expectDiscount(await quote(app, token, chosen.code, 100000), chosen.id, 27000, 73000);
+}
+
+async function enforceCreatedMinimum(app, admin, token, total, allowed) {
+  const coupon = await createCoupon(app, admin, {
+    code: 'MINIMUM_RULE', min_order_amount: 400000, discount_value: 27000,
+  });
+  const listed = await listCoupons(app, admin);
+  expect(listed.find(row => row.id === coupon.id)).toMatchObject({
+    min_order_amount: 400000, discount_value: 27000,
+  });
+  const response = await quote(app, token, coupon.code, total);
+  if (allowed) expectDiscount(response, coupon.id, 27000, 373001);
+  else expectRefusedQuote(response);
+}
+
+async function enforceCreatedExpiry(app, admin, instant, allowed) {
+  const coupon = await createCoupon(app, admin, {
+    code: 'EXPIRY_RULE', expired_at: '2026-10-24T09:00:00.000Z', discount_value: 27000,
+  });
+  const listed = await listCoupons(app, admin);
+  expect(listed.find(row => row.id === coupon.id).expired_at).toBe('2026-10-24T09:00:00.000Z');
+  h.freeze(instant);
+  const freshToken = await h.login(app, h.USER);
+  const response = await quote(app, freshToken, coupon.code, 100000);
+  if (allowed) expectDiscount(response, coupon.id, 27000, 73000);
+  else expectRefusedQuote(response);
+}
+
+async function isolateRecordedUsage(app, admin, token) {
+  const first = await createCoupon(app, admin, { code: 'USAGE_A', discount_value: 10000 });
+  const second = await createCoupon(app, admin, { code: 'USAGE_B', discount_value: 27000 });
+  const otherUser = await newUser(app);
+  // Usage recording is an explicit API call, separate from checkout.
+  const recorded = await h.request(app).post('/api/coupon-usage')
+    .set(h.bearer(token)).send({ coupon_id: first.id });
+  expect(recorded.status).toBe(200);
+  expectRefusedQuote(await quote(app, token, first.code, 100000));
+  expectDiscount(await quote(app, token, second.code, 100000), second.id, 27000, 73000);
+  expectDiscount(await quote(app, otherUser.token, first.code, 100000, otherUser.id), first.id, 10000, 90000);
+}
+
+module.exports = {
+  createCoupon, listCoupons, quote, expectDiscount, expectRefusedQuote,
+  selectCorrectCoupon, enforceCreatedMinimum, enforceCreatedExpiry, isolateRecordedUsage,
+};
diff --git a/backend/test/helpers/coupons.js b/backend/test/helpers/coupons.js
new file mode 100644
index 0000000000000000000000000000000000000000..8f7bc1f52502d5c8740f83c088f67927d097e572
--- /dev/null
+++ b/backend/test/helpers/coupons.js
@@ -0,0 +1,46 @@
+// Test-only fixtures. Real SQLite and SUT SQL; no production edits.
+const { loadApp, login, ADMIN, bearer, request, get } = require('./app');
+const NOW = '2026-10-22T12:00:00.000Z';
+const EXPIRY = '2026-10-23T12:00:00.000Z';
+const USER = { email: 'test@eshop.com', password: 'Test1234!' };
+function run(db, sql, params = []) {
+  return new Promise((resolve, reject) => db.run(sql, params, function (err) {
+    if (err) reject(err); else resolve({ id: this.lastID, changes: this.changes });
+  }));
+}
+function freeze(iso = NOW) {
+  jest.useFakeTimers({ now: Date.parse(iso), doNotFake: [
+    'nextTick', 'setImmediate', 'clearImmediate', 'setTimeout', 'clearTimeout',
+    'setInterval', 'clearInterval', 'queueMicrotask', 'performance', 'hrtime',
+  ] });
+}
+async function resetCoupons(db) {
+  await run(db, 'DELETE FROM coupon_usage');
+  await run(db, 'DELETE FROM coupons');
+  await run(db, "DELETE FROM sqlite_sequence WHERE name IN ('coupons', 'coupon_usage')");
+  await run(db, 'UPDATE users SET login_attempts = 0, locked_until = NULL');
+}
+async function seedCoupon(db, overrides = {}) {
+  const c = { code: 'FIXED50', type: 'fixed', discount_value: 50000,
+    min_order_amount: 500000, expired_at: EXPIRY, is_active: 1, max_uses_per_user: 2,
+    ...overrides };
+  const row = await run(db, `INSERT INTO coupons
+    (code,type,discount_value,min_order_amount,expired_at,is_active,max_uses_per_user)
+    VALUES (?,?,?,?,?,?,?)`, Object.values(c));
+  return { ...c, id: row.id };
+}
+async function seedUsage(db, couponId, userId, count) {
+  for (let i = 0; i < count; i++) {
+    await run(db, 'INSERT INTO coupon_usage(coupon_id,user_id) VALUES (?,?)', [couponId,userId]);
+  }
+}
+async function count(db, table) {
+  // Only test-owned table identifiers are accepted; values still use bind parameters.
+  if (!['coupons','coupon_usage'].includes(table)) throw new Error('Unsupported fixture table');
+  return (await get(db, 'SELECT COUNT(*) AS n FROM ' + table)).n;
+}
+const validAdminCoupon = () => ({ code: 'NEW_FIXED', type: 'fixed', discount_value: 25000,
+  min_order_amount: 0, expired_at: EXPIRY, max_uses_per_user: 1 });
+module.exports = { loadApp, login, ADMIN, USER, bearer, request, get, run,
+  NOW, EXPIRY, freeze, resetCoupons, seedCoupon, seedUsage, count, validAdminCoupon };
+
diff --git a/backend/test/helpers/isolate.js b/backend/test/helpers/isolate.js
new file mode 100644
index 0000000000000000000000000000000000000000..1d73b4d596a780b1e3775b27a510080f7adad300
--- /dev/null
+++ b/backend/test/helpers/isolate.js
@@ -0,0 +1,31 @@
+// Jest setupFiles: cô lập SUT mà KHÔNG sửa production code.
+// 1) sqlite3: mọi Database mở ':memory:' thay vì backend/database.sqlite
+//    -> mỗi test file (mỗi Jest worker) có DB riêng, không làm bẩn file đang track.
+// 2) express: bắt instance app do server.js tạo và thay app.listen bằng no-op
+//    -> không chiếm port 3000, test gọi app trực tiếp qua supertest.
+jest.mock('sqlite3', () => {
+  const actual = jest.requireActual('sqlite3');
+  class MemoryDatabase extends actual.Database {
+    constructor(_filename, ...rest) {
+      super(':memory:', ...rest);
+    }
+  }
+  const mocked = { ...actual, Database: MemoryDatabase };
+  mocked.verbose = () => mocked;
+  return mocked;
+});
+
+jest.mock('express', () => {
+  const actual = jest.requireActual('express');
+  const wrapped = (...args) => {
+    const app = actual(...args);
+    app.listen = (_port, cb) => {
+      if (cb) cb();
+      return { close() {} };
+    };
+    global.__ESHOP_APP__ = app;
+    return app;
+  };
+  Object.assign(wrapped, actual);
+  return wrapped;
+});
diff --git a/backend/test/manual/coupons.manual.js b/backend/test/manual/coupons.manual.js

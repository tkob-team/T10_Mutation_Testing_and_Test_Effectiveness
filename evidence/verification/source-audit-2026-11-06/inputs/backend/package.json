    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <13"
  },
  "packageManager": "npm@12.0.2"
}

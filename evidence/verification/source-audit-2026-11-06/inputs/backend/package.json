{
  "name": "backend",
  "version": "1.0.0",
  "description": "EShop mutation-testing research harness with reproducible baseline, manual and AI profiles",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/profile.cjs test overall baseline",
    "test:coupons": "node scripts/profile.cjs test coupons baseline",
    "test:defects": "jest --config jest.defects.config.cjs --runInBand",
    "coupons:dry": "node scripts/profile.cjs dry coupons baseline",
    "tutorial:weak": "jest --config tutorial/jest.weak.config.cjs --runInBand",
    "tutorial:ai": "jest --config tutorial/jest.ai.config.cjs --runInBand",
    "tutorial:mutate:weak": "stryker run tutorial/stryker.weak.config.json",
    "tutorial:mutate:ai": "stryker run tutorial/stryker.ai.config.json",
    "mutate:cart-orders": "node scripts/profile.cjs mutate cart-orders baseline",
    "test:auth": "node scripts/profile.cjs test auth baseline",
    "test:defects:auth": "jest --config jest.auth-defects.config.cjs --runInBand",
    "test:cart-orders": "node scripts/profile.cjs test cart-orders baseline",
    "mutate:coupons": "node scripts/profile.cjs mutate coupons baseline",
    "mutate:auth": "node scripts/profile.cjs mutate auth baseline",
    "tutorial:strong": "jest --config tutorial/jest.strong.config.cjs --runInBand",
    "tutorial:mutate:strong": "stryker run tutorial/stryker.strong.config.json",
    "test:auth:ai": "node scripts/profile.cjs test auth ai",
    "mutate:auth:ai": "node scripts/profile.cjs mutate auth ai",
    "test:auth:manual": "node scripts/profile.cjs test auth manual",
    "mutate:auth:manual": "node scripts/profile.cjs mutate auth manual",
    "dry:cart-orders": "node scripts/profile.cjs dry cart-orders baseline",
    "test:cart-orders:manual": "node scripts/profile.cjs test cart-orders manual",
    "dry:cart-orders:manual": "node scripts/profile.cjs dry cart-orders manual",
    "mutate:cart-orders:manual": "node scripts/profile.cjs mutate cart-orders manual",
    "test:cart-orders:ai": "node scripts/profile.cjs test cart-orders ai",
    "dry:cart-orders:ai": "node scripts/profile.cjs dry cart-orders ai",
    "mutate:cart-orders:ai": "node scripts/profile.cjs mutate cart-orders ai",
    "dry:coupons": "node scripts/profile.cjs dry coupons baseline",
    "test:coupons:manual": "node scripts/profile.cjs test coupons manual",
    "dry:coupons:manual": "node scripts/profile.cjs dry coupons manual",
    "mutate:coupons:manual": "node scripts/profile.cjs mutate coupons manual",
    "test:coupons:ai": "node scripts/profile.cjs test coupons ai",
    "dry:coupons:ai": "node scripts/profile.cjs dry coupons ai",
    "mutate:coupons:ai": "node scripts/profile.cjs mutate coupons ai",
    "dry:auth": "node scripts/profile.cjs dry auth baseline",
    "dry:auth:manual": "node scripts/profile.cjs dry auth manual",
    "dry:auth:ai": "node scripts/profile.cjs dry auth ai",
    "test:overall": "node scripts/profile.cjs test overall baseline",
    "dry:overall": "node scripts/profile.cjs dry overall baseline",
    "mutate:overall": "node scripts/profile.cjs mutate overall baseline",
    "test:overall:manual": "node scripts/profile.cjs test overall manual",
    "dry:overall:manual": "node scripts/profile.cjs dry overall manual",
    "mutate:overall:manual": "node scripts/profile.cjs mutate overall manual",
    "test:overall:ai": "node scripts/profile.cjs test overall ai",
    "dry:overall:ai": "node scripts/profile.cjs dry overall ai",
    "mutate:overall:ai": "node scripts/profile.cjs mutate overall ai",
    "test:manual": "node scripts/profile.cjs test overall manual",
    "test:ai": "node scripts/profile.cjs test overall ai",
    "audit": "node scripts/audit.cjs"
